# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "publishable" (sb_publishable_...) ou "anon" — publique par design, la RLS protège les données
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx
# Email du compte unique créé dans Supabase Auth (le mot de passe n'est JAMAIS ici)
VITE_LOGIN_EMAIL=stella.hub@example.com
# '/stella/' pour GitHub Pages, '/' pour Vercel
VITE_BASE=/
# 1 = données fictives en mémoire, sans Supabase (mot de passe : demo)
VITE_DEMO=0
